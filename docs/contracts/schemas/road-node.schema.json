{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboroute.local/contracts/road-node.schema.json",
  "title": "RoadNode",
  "description": "Intersection or singular point of the road graph. It is used both for the visible geometry and for routing.",
  "type": "object",
  "required": ["nodeId", "kind", "position"],
  "additionalProperties": false,
  "properties": {
    "nodeId": {
      "$ref": "common.schema.json#/$defs/nodeId"
    },
    "kind": {
      "type": "string",
      "enum": ["DEPOT", "JUNCTION", "DELIVERY"],
        "description": "DEPOT is the central depot, one per scenario. DELIVERY is the only kind that accepts orders."
    },
    "position": {
      "$ref": "common.schema.json#/$defs/point3d"
    },
    "label": {
      "type": "string",
      "maxLength": 40,
      "description": "Etiqueta opcional de presentacion."
    }
  }
}
