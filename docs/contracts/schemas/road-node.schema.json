{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboroute.local/contracts/road-node.schema.json",
  "title": "RoadNode",
  "description": "Interseccion o punto singular del grafo vial. Se usa tanto para la geometria visible como para el enrutado.",
  "type": "object",
  "required": ["nodeId", "kind", "position"],
  "additionalProperties": false,
  "properties": {
    "nodeId": {
      "$ref": "common.schema.json#/$defs/nodeId"
    },
    "kind": {
      "type": "string",
      "enum": ["DEPOT", "JUNCTION", "DELIVERY"],
      "description": "DEPOT es el deposito central, unico por escenario. DELIVERY es el unico tipo que admite pedidos."
    },
    "position": {
      "$ref": "common.schema.json#/$defs/point3d"
    },
    "label": {
      "type": "string",
      "maxLength": 40,
      "description": "Etiqueta opcional de presentacion."
    }
  }
}
