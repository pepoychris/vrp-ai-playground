{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboroute.local/contracts/route-plan.schema.json",
  "title": "RoutePlan",
  "description": "Best routes found by the optimizer for a specific revision. It does not claim optimality: solverOutcome and objectiveIsProvenOptimal describe what the solver returned.",
  "type": "object",
  "required": [
    "scenarioRevision",
    "generatedAt",
    "timeLimitSeconds",
    "solverOutcome",
    "objectiveIsProvenOptimal",
    "objectiveCost",
    "objectiveCostBreakdown",
    "vehicles",
    "unassignedOrders"
  ],
  "additionalProperties": false,
  "properties": {
    "scenarioRevision": {
      "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
    },
    "generatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "timeLimitSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Time limit applied to the search. The MVP uses 1 or 2 seconds."
    },
    "solverOutcome": {
      "$ref": "common.schema.json#/$defs/solverOutcome"
    },
    "objectiveIsProvenOptimal": {
      "type": "boolean",
        "description": "true only if the solver proves optimality within the limit. The UI never presents it as a guarantee of optimality."
    },
    "objectiveCost": {
      "$ref": "common.schema.json#/$defs/objectiveUnits"
    },
    "objectiveCostBreakdown": {
      "type": "object",
      "required": [
        "distanceMeters",
        "driveSeconds",
        "delaySeconds",
        "dropPenaltyUnits",
        "unassignedOrderCount"
      ],
      "additionalProperties": false,
      "properties": {
        "distanceMeters": {
          "$ref": "common.schema.json#/$defs/nonNegativeMeters"
        },
        "driveSeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        },
        "delaySeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        },
        "dropPenaltyUnits": {
          "$ref": "common.schema.json#/$defs/objectiveUnits"
        },
        "unassignedOrderCount": {
          "type": "integer",
          "minimum": 0
        }
      },
        "description": "Physical decomposition of the objective. The model's internal scale is fixed in Phase 5."
    },
    "vehicles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vehicleRoute"
      }
    },
    "unassignedOrders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unassignedOrder"
      }
    }
  },
  "$defs": {
    "vehicleRoute": {
      "type": "object",
      "title": "Route of one vehicle",
      "required": [
        "vehicleId",
        "nodeSequence",
        "edgeSequence",
        "stops",
        "distanceMeters",
        "driveSeconds",
        "loadUtilizationPercent",
        "endsAtSeconds"
      ],
      "additionalProperties": false,
      "properties": {
        "vehicleId": {
          "$ref": "common.schema.json#/$defs/vehicleId"
        },
        "nodeSequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/nodeId"
          },
        "description": "Exact node sequence. A route with no stops is [depotNodeId]."
        },
        "edgeSequence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/edgeId"
          },
        "description": "Edges traversed, in the same order as the nodeSequence pairs. Empty when there is no travel."
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stop"
          }
        },
        "distanceMeters": {
          "$ref": "common.schema.json#/$defs/nonNegativeMeters"
        },
        "driveSeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        },
        "loadUtilizationPercent": {
          "$ref": "common.schema.json#/$defs/percent"
        },
        "endsAtSeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        }
      }
    },
    "stop": {
      "type": "object",
      "title": "Delivery stop",
      "required": [
        "orderId",
        "nodeId",
        "arrivalSeconds",
        "serviceStartSeconds",
        "serviceEndSeconds",
        "delaySeconds"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "nodeId": {
          "$ref": "common.schema.json#/$defs/nodeId"
        },
        "arrivalSeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        },
        "serviceStartSeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        },
        "serviceEndSeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        },
        "delaySeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        }
      }
    },
    "unassignedOrder": {
      "type": "object",
      "title": "Unassigned order",
      "required": ["orderId", "reason"],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/orderId"
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/unassignedReason"
        }
      }
    }
  }
}
