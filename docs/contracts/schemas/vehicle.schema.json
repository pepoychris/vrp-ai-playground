{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboroute.local/contracts/vehicle.schema.json",
  "title": "Vehicle",
  "description": "Robot vehicle of the fleet. At most 6 per scenario.",
  "type": "object",
  "required": [
    "vehicleId",
    "capacityKilograms",
    "capacityCubicMeters",
    "loadKilograms",
    "loadCubicMeters",
    "batteryPercent",
    "speedKilometersPerHour",
    "costPerKilometerCents",
    "costPerMinuteCents",
    "fixedCostCents",
    "currentNodeId",
    "status",
    "assignedOrderIds"
  ],
  "additionalProperties": false,
  "properties": {
    "vehicleId": {
      "$ref": "common.schema.json#/$defs/vehicleId"
    },
    "capacityKilograms": {
      "type": "number",
      "exclusiveMinimum": 0,
        "description": "Load capacity in kilograms (kg). Always greater than zero."
    },
    "capacityCubicMeters": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Volume capacity in cubic metres (m3)."
    },
    "loadKilograms": {
      "$ref": "common.schema.json#/$defs/kilograms"
    },
    "loadCubicMeters": {
      "$ref": "common.schema.json#/$defs/cubicMeters"
    },
    "batteryPercent": {
      "$ref": "common.schema.json#/$defs/percent"
    },
    "speedKilometersPerHour": {
      "$ref": "common.schema.json#/$defs/kilometersPerHour"
    },
    "costPerKilometerCents": {
      "$ref": "common.schema.json#/$defs/euroCents"
    },
    "costPerMinuteCents": {
      "$ref": "common.schema.json#/$defs/euroCents"
    },
    "fixedCostCents": {
      "$ref": "common.schema.json#/$defs/euroCents"
    },
    "currentNodeId": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/nodeId"
        },
        {
          "type": "null"
        }
      ],
        "description": "Current vehicle node in the graph. null only while the vehicle has not been placed."
    },
    "status": {
      "$ref": "common.schema.json#/$defs/vehicleStatus"
    },
    "assignedOrderIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/orderId"
      },
        "description": "Orders assigned in the latest valid plan."
    }
  }
}
