{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboroute.local/contracts/order.schema.json",
  "title": "Order",
  "description": "Last-mile order. It is always placed on a node with kind DELIVERY reachable from the depot.",
  "type": "object",
  "required": [
    "orderId",
    "deliveryNodeId",
    "weightKilograms",
    "volumeCubicMeters",
    "priority",
    "timeWindow",
    "serviceSeconds",
    "status",
    "assignedVehicleId",
    "sequenceIndex"
  ],
  "additionalProperties": false,
  "properties": {
    "orderId": {
      "$ref": "common.schema.json#/$defs/orderId"
    },
    "deliveryNodeId": {
      "$ref": "common.schema.json#/$defs/nodeId"
    },
    "weightKilograms": {
      "type": "number",
      "exclusiveMinimum": 0,
        "description": "Order weight in kilograms (kg)."
    },
    "volumeCubicMeters": {
      "type": "number",
      "exclusiveMinimum": 0,
        "description": "Order volume in cubic meters (m3)."
    },
    "priority": {
      "$ref": "common.schema.json#/$defs/priority"
    },
    "timeWindow": {
      "type": "object",
      "required": ["startSeconds", "endSeconds"],
      "additionalProperties": false,
      "properties": {
        "startSeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        },
        "endSeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        }
      },
        "description": "Time window in seconds since t0. startSeconds < endSeconds must hold."
    },
    "serviceSeconds": {
      "type": "integer",
      "minimum": 1,
        "description": "Service time at the delivery point, in seconds."
    },
    "status": {
      "$ref": "common.schema.json#/$defs/orderStatus"
    },
    "assignedVehicleId": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/vehicleId"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequenceIndex": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
        "description": "Position inside the route of the assigned vehicle, starting at 0."
    }
  }
}
