{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboroute.local/contracts/scenario-revision.schema.json",
  "title": "ScenarioRevision",
  "description": "Atomic and authoritative snapshot of a scenario. Every mutation publishes a new one with an incremented scenarioRevision. The frontend discards any snapshot with a lower revision.",
  "type": "object",
  "required": [
    "scenarioId",
    "scenarioRevision",
    "previousRevision",
    "status",
    "graph",
    "vehicles",
    "orders",
    "barriers",
    "blockedEdgeIds",
    "routePlan",
    "kpis",
    "simulation",
    "appliedCommand",
    "emittedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "scenarioId": {
      "$ref": "common.schema.json#/$defs/scenarioId"
    },
    "scenarioRevision": {
      "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
    },
    "previousRevision": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "common.schema.json#/$defs/scenarioStatus"
    },
    "graph": {
      "type": "object",
      "required": ["cityId", "graphVersion", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "cityId": {
          "$ref": "common.schema.json#/$defs/cityId"
        },
        "graphVersion": {
          "$ref": "common.schema.json#/$defs/graphVersion"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "road-node.schema.json"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "road-edge.schema.json"
          }
        }
      },
        "description": "Immutable graph inside the scenario: nodes and edges do not change between revisions. The only thing that changes is blockedEdgeIds."
    },
    "vehicles": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "vehicle.schema.json"
      }
    },
    "orders": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "order.schema.json"
      }
    },
    "barriers": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "barrier.schema.json"
      }
    },
    "blockedEdgeIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/edgeId"
      },
        "description": "Source of truth for blocking. It derives exactly from the active barriers: {b.blockedEdgeId}."
    },
    "routePlan": {
      "oneOf": [
        {
          "$ref": "route-plan.schema.json"
        },
        {
          "type": "null"
        }
      ],
        "description": "Latest valid plan. null until a mission has been computed."
    },
    "kpis": {
      "oneOf": [
        {
          "$ref": "kpi-snapshot.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "simulation": {
      "type": "object",
      "required": ["running", "speedMultiplier", "tick", "elapsedSeconds"],
      "additionalProperties": false,
      "properties": {
        "running": {
          "type": "boolean"
        },
        "speedMultiplier": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "tick": {
          "$ref": "common.schema.json#/$defs/tick"
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0,
        "description": "Simulation clock in seconds. It does not create new revisions."
        }
      }
    },
    "appliedCommand": {
      "oneOf": [
        {
          "$ref": "envelopes.schema.json#/$defs/appliedCommand"
        },
        {
          "type": "null"
        }
      ],
        "description": "Command that produced this revision. null on the initial scenario revision."
    },
    "emittedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
