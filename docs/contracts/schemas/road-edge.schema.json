{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboroute.local/contracts/road-edge.schema.json",
  "title": "RoadEdge",
  "description": "Road segment between two nodes. It has no blocked field: the blockedEdgeIds list of ScenarioRevision is the single source of truth for blocking.",
  "type": "object",
  "required": [
    "edgeId",
    "fromNodeId",
    "toNodeId",
    "bidirectional",
    "lengthMeters",
    "speedLimitKph"
  ],
  "additionalProperties": false,
  "properties": {
    "edgeId": {
      "$ref": "common.schema.json#/$defs/edgeId"
    },
    "fromNodeId": {
      "$ref": "common.schema.json#/$defs/nodeId"
    },
    "toNodeId": {
      "$ref": "common.schema.json#/$defs/nodeId"
    },
    "bidirectional": {
      "type": "boolean",
        "description": "true on every edge: blocking the edge blocks both directions."
    },
    "lengthMeters": {
      "$ref": "common.schema.json#/$defs/positiveMeters"
    },
    "speedLimitKph": {
      "$ref": "common.schema.json#/$defs/kilometersPerHour"
    },
    "visualSplineControlPoints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "common.schema.json#/$defs/point3d"
      },
        "description": "Presentation only: it smooths the visible road. It is not used to compute distances or routes."
    }
  }
}
