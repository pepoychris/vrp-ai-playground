{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboroute.local/contracts/kpi-snapshot.schema.json",
  "title": "KpiSnapshot",
  "description": "Indicators for one revision. The economic cost is computed deterministically and is independent of the optimizer objective.",
  "type": "object",
  "required": [
    "scenarioRevision",
    "computedAt",
    "distanceTotalMeters",
    "plannedDurationSeconds",
    "economicCostCents",
    "economicCostBreakdown",
    "ordersDelivered",
    "ordersPending",
    "ordersDelayed",
    "ordersUnassigned",
    "activeVehicles",
    "capacityUtilizationPercentByVehicle",
    "lastIntervention"
  ],
  "additionalProperties": false,
  "properties": {
    "scenarioRevision": {
      "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
    },
    "computedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "distanceTotalMeters": {
      "$ref": "common.schema.json#/$defs/nonNegativeMeters"
    },
    "plannedDurationSeconds": {
      "$ref": "common.schema.json#/$defs/seconds"
    },
    "economicCostCents": {
      "$ref": "common.schema.json#/$defs/euroCents"
    },
    "economicCostBreakdown": {
      "type": "object",
      "required": [
        "activeVehicleFixedCostCents",
        "distanceCostCents",
        "driveTimeCostCents",
        "delayPenaltyCents",
        "unassignedOrderPenaltyCents"
      ],
      "additionalProperties": false,
      "properties": {
        "activeVehicleFixedCostCents": {
          "$ref": "common.schema.json#/$defs/euroCents"
        },
        "distanceCostCents": {
          "$ref": "common.schema.json#/$defs/euroCents"
        },
        "driveTimeCostCents": {
          "$ref": "common.schema.json#/$defs/euroCents"
        },
        "delayPenaltyCents": {
          "$ref": "common.schema.json#/$defs/euroCents"
        },
        "unassignedOrderPenaltyCents": {
          "$ref": "common.schema.json#/$defs/euroCents"
        }
      },
        "description": "The sum of the five fields must be exactly economicCostCents."
    },
    "ordersDelivered": {
      "type": "integer",
      "minimum": 0
    },
    "ordersPending": {
      "type": "integer",
      "minimum": 0
    },
    "ordersDelayed": {
      "type": "integer",
      "minimum": 0
    },
    "ordersUnassigned": {
      "type": "integer",
      "minimum": 0
    },
    "activeVehicles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
        "description": "Vehicles with at least one stop in the latest plan. Only they add fixed cost."
    },
    "capacityUtilizationPercentByVehicle": {
      "type": "object",
      "propertyNames": {
        "pattern": "^R-0[1-6]$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/percent"
      }
    },
    "lastIntervention": {
      "oneOf": [
        {
          "$ref": "#/$defs/interventionImpact"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "interventionImpact": {
      "type": "object",
      "title": "Impact of the last intervention",
      "required": ["kind", "comparedToRevision", "delta"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/interventionKind"
        },
        "comparedToRevision": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "delta": {
          "type": "object",
          "required": [
            "distanceTotalMeters",
            "plannedDurationSeconds",
            "economicCostCents",
            "ordersDelayed",
            "ordersUnassigned"
          ],
          "additionalProperties": false,
          "properties": {
            "distanceTotalMeters": {
              "type": "number",
              "description": "Diferencia firmada en metros (m) respecto a comparedToRevision."
            },
            "plannedDurationSeconds": {
              "type": "integer",
              "description": "Diferencia firmada en segundos (s)."
            },
            "economicCostCents": {
              "type": "integer",
        "description": "Signed difference in euro cents."
            },
            "ordersDelayed": {
              "type": "integer",
        "description": "Signed difference of the number of delayed orders."
            },
            "ordersUnassigned": {
              "type": "integer",
        "description": "Signed difference of the number of unassigned orders."
            }
          }
        }
      }
    }
  }
}
