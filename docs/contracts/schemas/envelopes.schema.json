{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboroute.local/contracts/envelopes.schema.json",
  "title": "Command, response, error and AI response envelopes",
  "description": "Envelopes frozen in Phase 0. Every mutation carries commandId and scenarioRevision; every mutation returns the complete atomic snapshot of the new revision.",
  "$defs": {
    "commandEnvelope": {
      "type": "object",
      "title": "Envelope de comando",
          "description": "Fields common to every state-mutating command. Each endpoint adds its own.",
      "required": ["commandId", "scenarioRevision"],
      "additionalProperties": true,
      "properties": {
        "commandId": {
          "$ref": "common.schema.json#/$defs/commandId"
        },
        "scenarioRevision": {
          "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
        }
      }
    },
    "appliedCommand": {
      "type": "object",
      "title": "Comando aplicado",
      "required": [
        "commandId",
        "kind",
        "appliedAgainstRevision",
        "rebased",
        "replayed"
      ],
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "$ref": "common.schema.json#/$defs/commandId"
        },
        "kind": {
          "$ref": "common.schema.json#/$defs/interventionKind"
        },
        "appliedAgainstRevision": {
          "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
        },
        "rebased": {
          "type": "boolean",
          "description": "true when the client's base revision was not the current one and the server applied the command on a newer one."
        },
        "replayed": {
          "type": "boolean",
          "description": "true when the stored result of an already processed commandId is returned without mutating again."
        }
      }
    },
    "positionSnapResult": {
      "type": "object",
      "title": "Claw snap result",
      "required": [
        "requestedWorldPoint",
        "snappedNodeId",
        "snappedPosition",
        "distanceMeters",
        "accepted",
        "rejectionCode"
      ],
      "additionalProperties": false,
      "properties": {
        "requestedWorldPoint": {
          "$ref": "common.schema.json#/$defs/point3d"
        },
        "snappedNodeId": {
          "$ref": "common.schema.json#/$defs/nodeId"
        },
        "snappedPosition": {
          "$ref": "common.schema.json#/$defs/point3d"
        },
        "distanceMeters": {
          "$ref": "common.schema.json#/$defs/nonNegativeMeters"
        },
        "accepted": {
          "type": "boolean"
        },
        "rejectionCode": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/snapRejectionCode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "barrierPlacementResult": {
      "type": "object",
      "title": "Barrier placement result",
      "required": [
        "barrierId",
        "blockedEdgeId",
        "projectedPoint",
        "distanceMeters",
        "accepted",
        "rejectionCode"
      ],
      "additionalProperties": false,
      "properties": {
        "barrierId": {
          "$ref": "common.schema.json#/$defs/barrierId"
        },
        "blockedEdgeId": {
          "$ref": "common.schema.json#/$defs/edgeId"
        },
        "projectedPoint": {
          "$ref": "common.schema.json#/$defs/point3d"
        },
        "distanceMeters": {
          "$ref": "common.schema.json#/$defs/nonNegativeMeters"
        },
        "accepted": {
          "type": "boolean"
        },
        "rejectionCode": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/snapRejectionCode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "successResponse": {
      "type": "object",
      "title": "Mutation response",
      "required": [
        "scenarioId",
        "scenarioRevision",
        "previousRevision",
        "emittedAt",
        "appliedCommand",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "$ref": "common.schema.json#/$defs/scenarioId"
        },
        "scenarioRevision": {
          "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
        },
        "previousRevision": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "emittedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "appliedCommand": {
          "$ref": "#/$defs/appliedCommand"
        },
        "revision": {
          "$ref": "scenario-revision.schema.json"
        },
        "result": {
        "description": "Endpoint-specific object. The known shapes are positionSnap and barrierPlacement.",
          "oneOf": [
            {
              "$ref": "#/$defs/positionSnapResult"
            },
            {
              "$ref": "#/$defs/barrierPlacementResult"
            },
            {
              "$ref": "route-plan.schema.json"
            },
            {
              "$ref": "#/$defs/installJob"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "MODEL_OVERRIDE_FORBIDDEN",
        "SCENARIO_NOT_FOUND",
        "VEHICLE_NOT_FOUND",
        "ORDER_NOT_FOUND",
        "BARRIER_NOT_FOUND",
        "PROPOSAL_NOT_FOUND",
        "BARRIER_LIMIT_REACHED",
        "NO_FLEET_DEPLOYED",
        "NO_ORDERS_AVAILABLE",
        "SIMULATION_NOT_RUNNING",
        "SNAP_OUT_OF_RADIUS",
        "SNAP_NO_VALID_EDGE",
        "AI_SERVICE_UNAVAILABLE",
        "AI_MODEL_NOT_INSTALLED",
        "AI_MODEL_NOT_LOADED",
        "AI_INSTALL_IN_PROGRESS",
        "AI_OUTPUT_INVALID",
        "INTERNAL_ERROR"
      ],
      "description": "Closed catalogue of contract v1 error codes."
    },
    "errorResponse": {
      "type": "object",
      "title": "Envelope de error",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/errorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "object",
      "description": "Extra error context, specific to each code."
            },
            "scenarioRevision": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
                },
                {
                  "type": "null"
                }
              ]
            },
            "commandId": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/commandId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "installJob": {
      "type": "object",
      "title": "Model installation job",
      "required": ["jobId", "state", "modelName", "startedAt"],
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": ["IDLE", "DOWNLOADING", "VERIFYING", "COMPLETED", "FAILED"]
        },
        "modelName": {
          "type": "string",
          "const": "qwen3:4b",
          "description": "Fixed by the backend. The browser cannot change it."
        },
        "startedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "finishedAt": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "aiStatus": {
      "type": "object",
      "title": "AI core status",
      "required": [
        "serviceAvailable",
        "modelInstalled",
        "modelLoaded",
        "modelName"
      ],
      "additionalProperties": false,
      "properties": {
        "serviceAvailable": {
          "type": "boolean",
      "description": "Ollama answers over the stack's internal network."
        },
        "modelInstalled": {
          "type": "boolean",
          "description": "qwen3:4b aparece en /api/tags."
        },
        "modelLoaded": {
          "type": "boolean",
          "description": "qwen3:4b is loaded in memory after POST /api/ai/activate."
        },
        "modelName": {
          "type": "string",
          "const": "qwen3:4b"
        },
        "installJob": {
          "oneOf": [
            {
              "$ref": "#/$defs/installJob"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "proposalKind": {
      "type": "string",
      "enum": [
        "SET_VEHICLE_UNAVAILABLE",
        "DELAY_VEHICLE",
        "REQUEST_REOPTIMIZATION"
      ],
      "description": "Proposals the model may suggest. None is applied without human confirmation."
    },
    "aiProposal": {
      "type": "object",
      "title": "Action proposal suggested by the AI",
      "required": ["proposalId", "kind", "summary", "payload", "status"],
      "additionalProperties": false,
      "properties": {
        "proposalId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/proposalKind"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "CONFIRMED", "REJECTED"]
        },
        "revisionToApply": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "aiChatResponse": {
      "type": "object",
      "title": "Chat response",
      "required": [
        "answer",
        "usedRevision",
        "references",
        "proposal",
        "timingsMs"
      ],
      "additionalProperties": false,
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1,
          "description": "Answer in English based exclusively on the validated snapshot."
        },
        "usedRevision": {
          "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
          "description": "Snapshot field path, e.g. kpis.economicCostCents."
          }
        },
        "proposal": {
          "oneOf": [
            {
              "$ref": "#/$defs/aiProposal"
            },
            {
              "type": "null"
            }
          ]
        },
        "timingsMs": {
          "type": "object",
          "required": ["total"],
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/milliseconds"
          }
        }
      }
    },
    "aiReportResponse": {
      "type": "object",
      "title": "Shift report",
      "required": [
        "scenarioRevision",
        "generatedAt",
        "markdown",
        "report",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "scenarioRevision": {
          "$ref": "common.schema.json#/$defs/scenarioRevisionNumber"
        },
        "generatedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        },
        "report": {
          "type": "object",
      "description": "Structured report validated against the JSON Schema before answering."
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
