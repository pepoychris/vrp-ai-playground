# RoboRoute Nexus repository ignore rules

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / Vite
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Build and test output
build/
out/
coverage/
test-results/

# Playwright: traces, videos and the screenshots captured as review evidence
playwright-report/
blob-report/
frontend/e2e/.artifacts/
frontend/e2e/screenshots/

# Design references supplied with the frontend task. They are inputs to the visual
# direction, not repository content, so they stay out of every commit.
/Landing futurista con flota robótica.png
/Dashboard de optimización y mapa de rutas.png
/Constructor de escenarios con recomendaciones IA.png

# CodeGraph's index is a machine-local database (see AGENTS.md).
.codegraph/

# The demo pipeline's live capture frames. They are transient inputs to the GIF build,
# produced by tools/demos/capture_*.mjs and removed once assets/demos is rebuilt.
tools/demos/.frames/

# Environment files - real configuration and secrets are never committed
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/
tmp/
temp/

# IDE / OS noise
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini
