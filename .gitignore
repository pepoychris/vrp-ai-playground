# RoboRoute Nexus repository ignore rules

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / Vite
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Build and test output
build/
out/
coverage/
test-results/

# Environment files - real configuration and secrets are never committed
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/
tmp/
temp/

# IDE / OS noise
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini
