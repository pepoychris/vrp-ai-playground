# RoboRoute Nexus local stack (MVP Phase 1).
#
# Every value has a safe default inside compose.yaml, so copying this file is only
# necessary to override something. `docker compose up --build` works without it.

# Host ports for the two published services.
# Ollama is never published: it stays on the internal `backend` network.
FRONTEND_PORT=8080
API_PORT=8000

# How long the API waits for Ollama before reporting it as unavailable, in seconds.
ROBOROUTE_OLLAMA_TIMEOUT_SECONDS=2.0

# SQLite file inside the api container, backed by the sqlite-data volume.
# Phase 1 configures the path but does not write to it yet.
ROBOROUTE_DB_PATH=/data/roboroute.db
